apiVersion: apps/v1
kind: Deployment
metadata:
  name: elasticsearch-master-2
  namespace: observability
spec:
  replicas: 1
  selector:
    matchLabels:
      app: elasticsearch-master-2
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: elasticsearch-master-2
    spec:
      containers:
      - name: elasticsearch
        image: docker.elastic.co/elasticsearch/elasticsearch:8.19.19
        ports:
        - containerPort: 9200
        - containerPort: 9300
        resources:
          requests:
            memory: 1Gi
            cpu: 500m
          limits:
            memory: 2Gi
        volumeMounts:
        - name: configuration
          mountPath: /usr/share/elasticsearch/config/elasticsearch.yml
          subPath: elasticsearch.yml
        - name: data
          mountPath: /usr/share/elasticsearch/data
      volumes:
      - name: configuration
        configMap:
          name: elasticsearch-master-2
      - name: data
        persistentVolumeClaim:
          claimName: elasticsearch-master-2
