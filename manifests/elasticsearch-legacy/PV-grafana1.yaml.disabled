apiVersion: v1
kind: PersistentVolume
metadata:
  name: observability-elk-grafana1
spec:
  capacity:
    storage: Gi
  nfs:
    server: __CFG_1590__
    path: __CFG_1599__
  accessModes:
  - ReadWriteOnce
  claimRef:
    kind: PersistentVolumeClaim
    namespace: observability
    name: observability-elk-grafana1
    apiVersion: v1
  persistentVolumeReclaimPolicy: Retain
  storageClassName: __CFG_1592__
  volumeMode: Filesystem
